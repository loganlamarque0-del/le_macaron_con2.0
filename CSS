
body {
  margin: 0;
  text-align: center;
  background: #171c2b;
  color: white;
  font-family: Arial, sans-serif;
}

h1 {
  color: #ffd43b;
  margin: 20px;
}

#infos {
  display: flex;
  justify-content: center;
  gap: 40px;
  margin: 15px;
  font-size: 20px;
}

canvas {
  background: #478b45;
  border: 5px solid #ffffff;
  max-width: 95%;
  height: auto;
  cursor: crosshair;
}

button {
  background: #ffbd35;
  border: none;
  padding: 12px 25px;
  border-radius: 10px;
  font-size: 18px;
  cursor: pointer;
}

button:hover {
  background: #ffdf75;
}
